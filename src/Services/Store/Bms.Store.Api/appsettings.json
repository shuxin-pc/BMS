{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "UseHttpsRedirection": false
  },
  "SeedTestData": {
    "Enabled": false,
    "Description": "测试种子数据开关。true=从 JSON 资源加载测试业务数据（覆盖现有数据），false=不加载。仅测试/开发环境启用。菜单数据由 StoreMenuRegistrationService 自动注册。"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bms_store;Username=postgres;Password=123456",
    "SystemDb": "Host=localhost;Port=5432;Database=bms_system;Username=postgres;Password=123456"
  },
  "SnowflakeId": {
    "WorkerId": 2,
    "DatacenterId": 1
  },
  "SystemApi": {
    "BaseUrl": "http://localhost:5000"
  },
  "InternalServices": {
    "ServiceName": "StoreService",
    "ServiceKey": "StoreService-Internal-Key-2026"
  },
  "ObjectStorage": {
    "Endpoint": "http://localhost:9000",
    "PublicEndpoint": "http://localhost:9000",
    "AccessKey": "mes",
    "SecretKey": "mes@2026",
    "BucketName": "bms-store",
    "PresignExpireMinutes": 30,
    "MaxFileSizeBytes": 10485760,
